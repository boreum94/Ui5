<mvc:View
    controllerName="node.t2.quotationmanagement.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f">

    <f:DynamicPage
        id="detailDynamicPage"
        toggleHeaderOnTitleClick="false">

        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="견적 상세"/>
                </f:heading>
                <f:actions>
                    <Button
                        text="견적 송출"
                        type="Emphasized"
                        icon="sap-icon://paper-plane"
                        press=".onSendQuotation"/>
                </f:actions>
                <f:navigationActions>
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        press=".onNavBack"/>
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox class="sapUiSmallMargin">

                <Panel headerText="기본 정보">
                    <content>
                        <HBox renderType="Bare">
                            <VBox width="33%">
                                <Label text="견적번호"/>
                                <Text text="{view>/header/QuotCd}"/>

                                <Label text="견적유형" class="sapUiSmallMarginTop"/>
                                <Text text="{view>/header/QuotDocTy}"/>

                                <Label text="고객" class="sapUiSmallMarginTop"/>
                                <Text text="{view>/header/CustomerNm}"/>
                            </VBox>

                            <VBox width="33%">
                                <Label text="문서일자"/>
                                <Text text="{
                                    path: 'view>/header/DocDate',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: { pattern: 'yyyy-MM-dd' }
                                }"/>

                                <Label text="요청납기일" class="sapUiSmallMarginTop"/>
                                <Text text="{
                                    path: 'view>/header/ReqDueDate',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: { pattern: 'yyyy-MM-dd' }
                                }"/>

                                <Label text="지급조건" class="sapUiSmallMarginTop"/>
                                <Text text="{view>/header/PaymentNm}"/>
                            </VBox>

                            <VBox width="33%">
                                <Label text="상태"/>
                                <ObjectStatus
                                    text="{path: 'view>/header/QuotStatus', formatter: '.formatStatusText'}"
                                    state="{path: 'view>/header/QuotStatus', formatter: '.formatStatusState'}"/>

                                <Label text="총금액" class="sapUiSmallMarginTop"/>
                                <ObjectNumber
                                    number="{view>/header/TtlAmount}"
                                    unit="{view>/header/Currency}"
                                    emphasized="true"/>
                            </VBox>
                        </HBox>
                    </content>
                </Panel>

                <IconTabBar
                    class="sapUiSmallMarginTop"
                    expandable="false">
                    <items>
                        <IconTabFilter
                            key="items"
                            text="Item 정보">
                            <Table
                                id="detailItemTable"
                                items="{view>/items}">
                                <columns>
                                    <Column width="5rem">
                                        <Text text="No."/>
                                    </Column>
                                    <Column>
                                        <Text text="자재코드"/>
                                    </Column>
                                    <Column>
                                        <Text text="자재명"/>
                                    </Column>
                                    <Column width="5rem">
                                        <Text text="등급"/>
                                    </Column>
                                    <Column hAlign="End" width="7rem">
                                        <Text text="수량"/>
                                    </Column>
                                    <Column width="5rem">
                                        <Text text="단위"/>
                                    </Column>
                                    <Column hAlign="End">
                                        <Text text="단가"/>
                                    </Column>
                                    <Column hAlign="End">
                                        <Text text="금액"/>
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{view>ItemCd}"/>
                                            <Text text="{view>MaterialCd}"/>
                                            <Text text="{view>MaterialNm}"/>
                                            <Text text="{view>CurrentGrade}"/>
                                            <Text text="{view>ReqQty}"/>
                                            <Text text="{view>Unit}"/>
                                            <ObjectNumber
                                                number="{view>IndividualAmt}"
                                                unit="{view>Currency}"/>
                                            <ObjectNumber
                                                number="{view>NetAmt}"
                                                unit="{view>Currency}"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>

                        <IconTabFilter
                            key="etc"
                            text="기타 정보">
                            <Text text="첨부파일, 변경이력, 송출이력은 추후 확장 영역입니다."/>
                        </IconTabFilter>
                    </items>
                </IconTabBar>

            </VBox>
        </f:content>

    </f:DynamicPage>
</mvc:View>