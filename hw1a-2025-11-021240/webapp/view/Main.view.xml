<mvc:View controllerName="code.d22.hw1a.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    >

    <Shell id="rootId">
        <Page id="page" title="{i18n>title}">
            <Panel
                headerText="{i18n>panelTitle}"
                id="firstPanel">
                <content>
                    <!-- 버튼끼리 붙어있는게 답답해 보여서 마진효과를 사용했음 -->
                    <Label text="입력" 
                        class="sapUiResponsiveMargin"/>
                    <!-- 메세지 토스트 박스에 사용자가 입력한 값을 컨트롤러의 함수에 전달하기 위해
                    Input 컨트롤에 myInput 이라는 id를 줬다. 
                    valueLiveUpdate를 통해 사용자가 입력한 값이 바뀌면 
                    실시간으로 바뀌도록 햇다. -->
                    <Input 
                        id="myInput" 
                        valueLiveUpdate="true"
                        width="30%" 
                        class="sapUiResponsiveMargin"/>
                    <!-- 버튼이 눌릴때마다 onShowContext 함수가 실행되게 만들고,
                    이 뷰와 연결된 컨트롤러에 그 함수가 있다는걸 위해 '.' 을 붙였다 -->
                    <Button 
                        text="{i18n>buttonName}"
                        press=".onShowContext" 
                        class="sapUiResponsiveMargin"/>
                </content>
            </Panel>
            <Panel>
                <content>
                    <!-- Input에 id를 주고 컨트롤러 함수에서 이 id를
                    통해 Input에 사용자가 입력한 내용을 가져온다 -->
                    <Label 
                    text="입력" 
                    class="sapUiResponsiveMargin"/>
                    <!-- 뷰에 모델을 바인딩 하기 위해 value="" 사용함 -->
                    <!-- value="{/items}"로 충분 -->
                    <Input 
                        id="secondInput"
                        value="{Item>/items}" 
                        valueLiveUpdate="true"
                        width="30%"
                        class="sapUiResponsiveMargin"
                        />
                    <Button 
                        text="{i18n>buttonName}"
                        press=".onShowMessage" 
                        class="sapUiResponsiveMargin"/>
                    
                </content>
                <content>

                    
                </content>
            </Panel>
        </Page>
    </Shell>
</mvc:View>