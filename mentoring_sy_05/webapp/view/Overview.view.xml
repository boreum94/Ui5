<mvc:View controllerName="code.d22.mentoringsy05.controller.Overview"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <Panel >
            <headerToolbar>
                <Toolbar >
                    <Title text="{i18n>listToolbarTitle}" />
                    <ToolbarSpacer />
                </Toolbar>
            </headerToolbar>
        <content>
            <Button text="{i18n>Products}"
                    icon="sap-icon://product"
                    class="sapUiSmallMarginEnd"
                    press=".onButtonProduct" />
            <Button text="{i18n>BusinessPartners}"
                    icon="sap-icon://business-objects-experience"
                    class="sapUiSmallMarginEnd"
                    press=".onButtonBP" />
            <!-- Product 테이블 -->
            <Table 
                id="productId"
                items="{/ProductSet}"
                visible="true"
                growingThreshold="5"
                growing="true" >
                <columns>
                    <Column ><header><Text text="{i18n>ID}" /></header></Column>
                    <Column ><header><Text text="{i18n>Name}" /></header></Column>
                    <Column ><header><Text text="{i18n>Category}" /></header></Column>
                </columns>
                <items>
                    <ColumnListItem >
                        <ObjectIdentifier title="{ProductId}" />
                        <Text text="{ path: 'Name' }" />
                        <Text text="{ path: 'Category' }" />
                    </ColumnListItem>
                </items>
            </Table>
            <!-- Business Partners 테이블 -->
            <Table 
                id="bpId"
                items="{/BusinessParnerSet}"
                visible="false" >
                <columns>
                    <Column ><header><Text text="{i18n>BPID}" /></header></Column>
                    <Column ><header><Text text="{i18n>Company}" /></header></Column>
                    <Column ><header><Text text="{i18n>Email}" /></header></Column>
                </columns>
                <items>
                    <ColumnListItem >
                        <ObjectIdentifier title="{BusinessPartnerID}" />
                        <Text text="{ path: 'CompanyName' }" />
                        <Text text="{ path: 'EmailAddress' }" />
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        </Panel>
    </Page>
</mvc:View>