<mvc:View controllerName="code.d22.exam3.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <Panel>
            <Table 
                headerText="{i18n>TableHeaderText}"
                growing="true"
                growingThreshold="9"
                class="sapUiResponsiveMargin"
                width="auto"
                items="{/Employees}"
                

            >
                <columns>
                    <Column><header><Text text="{i18n>employeeId}"/></header></Column>
                    <Column><header><Text text="{i18n>courtesy}"/></header></Column>
                    <Column><header><Text text="{i18n>name}"/></header></Column>
                    <Column><header><Text text="{i18n>employeeTitle}"/></header></Column>
                    <Column><header><Text text="{i18n>hiredDate}"/></header></Column>
                    <Column><header><Text text="{i18n>nationality}"/></header></Column>
                </columns>

                <items>
                    <ColumnListItem
                        type="Navigation"
                        press=".onOpenDialog"
                    >
                        <cells>
                            <ObjectIdentifier title="{EmployeeID}"/>
                            <Text text=" {path: 'TitleOfCourtesy'}, 
                                                {path: 'LastName'} " />
                            <Text text="{FirstName}" />
                            <Text text="{Title}" />
                            <Text text="{ path: 'HireDate',
                                        type: 'sap.ui.model.type.Date',
                                        formatOptions: {
                                            pattern: 'yyyy.MM.dd'
                                        } }" 
                            />
                            <Text text="{Country}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>
    </Page>
</mvc:View>