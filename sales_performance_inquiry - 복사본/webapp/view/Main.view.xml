<mvc:View
    controllerName="node.t2.salesperformanceinquiry.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:table="sap.ui.table"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    displayBlock="true">

    <f:DynamicPage
        id="page"
        headerExpanded="true"
        toggleHeaderOnTitleClick="false">

        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="판매실적 조회" level="H1"/>
                </f:heading>
                <f:snappedHeading>
                    <Title text="판매실적 조회" level="H2"/>
                </f:snappedHeading>
                <f:expandedContent>
                    <ObjectStatus
                        text="연도별 분기 판매건수 및 카테고리 KPI 분석"
                        state="Information"/>
                </f:expandedContent>
                <f:actions>
                    <Button
                        text="조회"
                        type="Emphasized"
                        icon="sap-icon://search"
                        press=".onSearch"
                        enabled="{= !${view>/busy}}"/>
                    <Button
                        text="초기화"
                        type="Transparent"
                        icon="sap-icon://reset"
                        press=".onReset"
                        enabled="{= !${view>/busy}}"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <HBox wrap="Wrap" renderType="Bare">

                    <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                        <Label text="연도" labelFor="yearSelect"/>
                        <Select
                            id="yearSelect"
                            width="10rem"
                            selectedKey="{view>/filter/year}">
                            <core:Item key="2026" text="2026"/>
                            <core:Item key="2025" text="2025"/>
                            <core:Item key="2024" text="2024"/>
                            <core:Item key="" text="전체"/>
                        </Select>
                    </VBox>

                    <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                        <Label text="카테고리" labelFor="categorySelect"/>
                        <Select
                            id="categorySelect"
                            width="12rem"
                            selectedKey="{view>/filter/itemCategory}">
                            <core:Item key="" text="전체"/>
                            <core:Item key="MTS" text="MTS"/>
                            <core:Item key="MTO" text="MTO"/>
                            <core:Item key="REN" text="렌탈"/>
                        </Select>
                    </VBox>

                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox
                busy="{view>/busy}"
                busyIndicatorDelay="0"
                class="sapUiContentPadding">

                <!-- KPI Summary Tiles -->
                <layout:Grid
                    defaultSpan="XL3 L3 M6 S12"
                    hSpacing="1"
                    vSpacing="1"
                    class="sapUiSmallMarginBottom">

                    <GenericTile
                        header="당해 총 매출"
                        subheader="{= ${view>/filter/year} ? ${view>/filter/year} + '년 기준' : '전체 기준'}"
                        class="sapUiTinyMarginBottom">
                        <TileContent footer="{view>/kpi/currency}">
                            <NumericContent
                                icon="sap-icon://money-bills"
                                value="{view>/kpi/totalYearAmtFormatted}"
                                scale="{view>/kpi/amtScale}"
                                valueColor="Good"/>
                        </TileContent>
                    </GenericTile>

                    <GenericTile
                        header="총 판매건수"
                        subheader="{= ${view>/filter/year} ? ${view>/filter/year} + '년 기준' : '전체 기준'}"
                        class="sapUiTinyMarginBottom">
                        <TileContent footer="건">
                            <NumericContent
                                icon="sap-icon://sales-order"
                                value="{view>/kpi/totalSalesCount}"
                                valueColor="Good"/>
                        </TileContent>
                    </GenericTile>

                    <GenericTile
                        header="전체 YoY 성장률"
                        subheader="전년 동기 대비"
                        class="sapUiTinyMarginBottom">
                        <TileContent footer="%">
                            <NumericContent
                                icon="sap-icon://line-chart"
                                value="{view>/kpi/ttlYoyGrowthPct}"
                                scale="%"
                                valueColor="{view>/kpi/growthColor}"
                                indicator="{view>/kpi/growthIndicator}"/>
                        </TileContent>
                    </GenericTile>

                    <GenericTile
                        header="최고 점유 카테고리"
                        subheader="매출 점유율 기준"
                        class="sapUiTinyMarginBottom">
                        <TileContent footer="{view>/kpi/bestCategoryShare}">
                            <NumericContent
                                icon="sap-icon://pie-chart"
                                value="{view>/kpi/bestCategory}"
                                valueColor="Neutral"/>
                        </TileContent>
                    </GenericTile>

                </layout:Grid>

                <!-- Tab Bar -->
                <IconTabBar
                    id="mainTabBar"
                    expandable="false"
                    class="sapUiResponsiveContentPadding">

                    <items>

                        <!-- Tab 1: Quarter Sales -->
                        <IconTabFilter
                            key="quarter"
                            text="분기별 판매건수"
                            icon="sap-icon://bar-chart">

                            <VBox>

                                <Panel class="sapUiSmallMarginBottom">
                                    <headerToolbar>
                                        <OverflowToolbar>
                                            <Title text="분기별 판매건수 추이"/>
                                            <ToolbarSpacer/>
                                            <ObjectStatus text="단위: 건" state="Information"/>
                                        </OverflowToolbar>
                                    </headerToolbar>

                                    <viz:VizFrame
                                        id="quarterChart"
                                        width="100%"
                                        height="22rem"
                                        vizType="column">

                                        <viz:dataset>
                                            <viz.data:FlattenedDataset data="{view>/quarterChart}">
                                                <viz.data:dimensions>
                                                    <viz.data:DimensionDefinition
                                                        name="분기"
                                                        value="{view>Label}"/>
                                                </viz.data:dimensions>
                                                <viz.data:measures>
                                                    <viz.data:MeasureDefinition
                                                        name="판매건수"
                                                        value="{view>Salescount}"/>
                                                </viz.data:measures>
                                            </viz.data:FlattenedDataset>
                                        </viz:dataset>

                                        <viz:feeds>
                                            <viz.feeds:FeedItem
                                                uid="valueAxis"
                                                type="Measure"
                                                values="판매건수"/>
                                            <viz.feeds:FeedItem
                                                uid="categoryAxis"
                                                type="Dimension"
                                                values="분기"/>
                                        </viz:feeds>

                                    </viz:VizFrame>
                                </Panel>

                                <Panel>
                                    <headerToolbar>
                                        <OverflowToolbar>
                                            <Title text="연도별 분기 판매건수"/>
                                            <ToolbarSpacer/>
                                            <ObjectStatus text="단위: 건" state="Information"/>
                                        </OverflowToolbar>
                                    </headerToolbar>

                                    <table:Table
                                        rows="{view>/quarterTable}"
                                        selectionMode="None"
                                        visibleRowCountMode="Auto"
                                        minAutoRowCount="4"
                                        alternateRowColors="true"
                                        noData="조회된 데이터가 없습니다."
                                        width="100%">

                                        <table:columns>

                                            <table:Column width="8rem" hAlign="Center">
                                                <Label text="연도"/>
                                                <table:template>
                                                    <Text text="{view>Syear}"/>
                                                </table:template>
                                            </table:Column>

                                            <table:Column width="8rem" hAlign="End">
                                                <Label text="1분기"/>
                                                <table:template>
                                                    <ObjectNumber
                                                        number="{view>Q1}"
                                                        unit="건"
                                                        emphasized="false"/>
                                                </table:template>
                                            </table:Column>

                                            <table:Column width="8rem" hAlign="End">
                                                <Label text="2분기"/>
                                                <table:template>
                                                    <ObjectNumber
                                                        number="{view>Q2}"
                                                        unit="건"
                                                        emphasized="false"/>
                                                </table:template>
                                            </table:Column>

                                            <table:Column width="8rem" hAlign="End">
                                                <Label text="3분기"/>
                                                <table:template>
                                                    <ObjectNumber
                                                        number="{view>Q3}"
                                                        unit="건"
                                                        emphasized="false"/>
                                                </table:template>
                                            </table:Column>

                                            <table:Column width="8rem" hAlign="End">
                                                <Label text="4분기"/>
                                                <table:template>
                                                    <ObjectNumber
                                                        number="{view>Q4}"
                                                        unit="건"
                                                        emphasized="false"/>
                                                </table:template>
                                            </table:Column>

                                            <table:Column width="9rem" hAlign="End">
                                                <Label text="연간 합계"/>
                                                <table:template>
                                                    <ObjectNumber
                                                        number="{view>Total}"
                                                        unit="건"
                                                        emphasized="true"
                                                        state="Success"/>
                                                </table:template>
                                            </table:Column>

                                        </table:columns>
                                    </table:Table>
                                </Panel>

                            </VBox>
                        </IconTabFilter>

                        <!-- Tab 2: Category KPI -->
                        <IconTabFilter
                            key="kpi"
                            text="카테고리 KPI"
                            icon="sap-icon://business-objects-experience">

                            <VBox>

                                <layout:Grid
                                    defaultSpan="XL6 L6 M12 S12"
                                    hSpacing="1"
                                    vSpacing="0"
                                    class="sapUiSmallMarginBottom">

                                    <Panel>
                                        <headerToolbar>
                                            <OverflowToolbar>
                                                <Title text="카테고리별 매출 점유율"/>
                                            </OverflowToolbar>
                                        </headerToolbar>

                                        <viz:VizFrame
                                            id="shareChart"
                                            width="100%"
                                            height="22rem"
                                            vizType="donut">

                                            <viz:dataset>
                                                <viz.data:FlattenedDataset data="{view>/categoryKpi}">
                                                    <viz.data:dimensions>
                                                        <viz.data:DimensionDefinition
                                                            name="카테고리"
                                                            value="{view>Categoryname}"/>
                                                    </viz.data:dimensions>
                                                    <viz.data:measures>
                                                        <viz.data:MeasureDefinition
                                                            name="점유율"
                                                            value="{view>Sharepct}"/>
                                                    </viz.data:measures>
                                                </viz.data:FlattenedDataset>
                                            </viz:dataset>

                                            <viz:feeds>
                                                <viz.feeds:FeedItem
                                                    uid="size"
                                                    type="Measure"
                                                    values="점유율"/>
                                                <viz.feeds:FeedItem
                                                    uid="color"
                                                    type="Dimension"
                                                    values="카테고리"/>
                                            </viz:feeds>

                                        </viz:VizFrame>
                                    </Panel>

                                    <Panel>
                                        <headerToolbar>
                                            <OverflowToolbar>
                                                <Title text="당해 vs 전년 매출 비교"/>
                                            </OverflowToolbar>
                                        </headerToolbar>

                                        <viz:VizFrame
                                            id="compareChart"
                                            width="100%"
                                            height="22rem"
                                            vizType="bar">

                                            <viz:dataset>
                                                <viz.data:FlattenedDataset data="{view>/categoryKpi}">
                                                    <viz.data:dimensions>
                                                        <viz.data:DimensionDefinition
                                                            name="카테고리"
                                                            value="{view>Categoryname}"/>
                                                    </viz.data:dimensions>
                                                    <viz.data:measures>
                                                        <viz.data:MeasureDefinition
                                                            name="당해 매출"
                                                            value="{view>Currentyearamt}"/>
                                                        <viz.data:MeasureDefinition
                                                            name="전년 매출"
                                                            value="{view>Prevyearamt}"/>
                                                    </viz.data:measures>
                                                </viz.data:FlattenedDataset>
                                            </viz:dataset>

                                            <viz:feeds>
                                                <viz.feeds:FeedItem
                                                    uid="valueAxis"
                                                    type="Measure"
                                                    values="당해 매출,전년 매출"/>
                                                <viz.feeds:FeedItem
                                                    uid="categoryAxis"
                                                    type="Dimension"
                                                    values="카테고리"/>
                                            </viz:feeds>

                                        </viz:VizFrame>
                                    </Panel>

                                </layout:Grid>

                                <Panel>
                                    <headerToolbar>
                                        <OverflowToolbar>
                                            <Title text="카테고리별 KPI 상세"/>
                                            <ToolbarSpacer/>
                                            <ObjectStatus
                                                text="{= ${view>/filter/year} ? ${view>/filter/year} + '년 / 전년 비교' : '전체'}"
                                                state="Information"/>
                                        </OverflowToolbar>
                                    </headerToolbar>

                                    <table:Table
                                        rows="{view>/categoryKpi}"
                                        selectionMode="None"
                                        visibleRowCountMode="Auto"
                                        minAutoRowCount="5"
                                        alternateRowColors="true"
                                        noData="조회된 데이터가 없습니다."
                                        width="100%">

                                        <table:columns>

                                            <table:Column width="6rem" hAlign="Center">
                                                <Label text="연도"/>
                                                <table:template>
                                                    <Text text="{view>Syear}"/>
                                                </table:template>
                                            </table:Column>

                                            <table:Column width="12rem">
                                                <Label text="카테고리"/>
                                                <table:template>
                                                    <ObjectIdentifier
                                                        title="{view>Categoryname}"
                                                        text="{view>Itemcategory}"/>
                                                </table:template>
                                            </table:Column>

                                            <table:Column width="14rem" hAlign="End">
                                                <Label text="당해 매출"/>
                                                <table:template>
                                                    <ObjectNumber
                                                        number="{view>Currentyearamt}"
                                                        unit="{view>Currency}"/>
                                                </table:template>
                                            </table:Column>

                                            <table:Column width="14rem" hAlign="End">
                                                <Label text="전년 매출"/>
                                                <table:template>
                                                    <ObjectNumber
                                                        number="{view>Prevyearamt}"
                                                        unit="{view>Currency}"
                                                        emphasized="false"/>
                                                </table:template>
                                            </table:Column>

                                            <table:Column width="11rem" hAlign="End">
                                                <Label text="YoY 성장률"/>
                                                <table:template>
                                                    <ObjectStatus
                                                        text="{parts: [{path: 'view>Yoygrowthpct'}], formatter: '.formatGrowthText'}"
                                                        state="{parts: [{path: 'view>Yoygrowthpct'}], formatter: '.formatGrowthState'}"/>
                                                </table:template>
                                            </table:Column>

                                            <table:Column width="10rem" hAlign="End">
                                                <Label text="점유율"/>
                                                <table:template>
                                                    <ObjectNumber
                                                        number="{view>Sharepct}"
                                                        unit="%"
                                                        emphasized="false"/>
                                                </table:template>
                                            </table:Column>

                                            <table:Column width="10rem" hAlign="End">
                                                <Label text="판매건수"/>
                                                <table:template>
                                                    <ObjectNumber
                                                        number="{view>Categorysalescount}"
                                                        unit="건"
                                                        emphasized="false"/>
                                                </table:template>
                                            </table:Column>

                                        </table:columns>
                                    </table:Table>
                                </Panel>

                            </VBox>
                        </IconTabFilter>

                    </items>
                </IconTabBar>

            </VBox>
        </f:content>

    </f:DynamicPage>
</mvc:View>
