<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- id는 나중에 닫을 때 필요해서 쓴다 이거야 -->
    <Dialog
        id="helloDialog"
        title="Hello {/recipient/name}" >
        <content>
            <core:Icon
                src="sap-icon://hello-world"
                size="8rem"
                class="sapUiMediumMargin" />
        </content>
    <!-- Dialog에 닫기 버튼 생성 -->
    <beginButton>
        <Button
            text="{i18n>dialogCloseButtonText}"
            press=".onCloseDialog" />
    </beginButton>
    </Dialog>    
</core:FragmentDefinition>