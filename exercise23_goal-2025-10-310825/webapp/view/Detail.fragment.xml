<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <Dialog 
        id="idDialog"
    >
        <content>
            <!-- 선택한 고객의 BindingContext를 가져와서, 아래 idOrderTable에 BindingContext를 기록하여
                고객의 주문내역을 출력하도록 한다.
                이때 선택한 고객의 주문내역으로 보여줄 데이터는 다음과 같다.
                -   OrderID
                -   OrderDate
                -   RequiredDate
                -   ShippedDate
                -   ShipName
                -   ShipCity
                -   ShipCountry
            -->
            <Table id="idOrderTable" items="{Orders}">
                <columns>
                    <Column><header><Text text="{i18n>columnTextOrderID}" /></header></Column>
                    <Column><header><Text text="{i18n>columnTextOrderDate}" /></header></Column>
                    <Column><header><Text text="{i18n>columnTextRequiredDate}" /></header></Column>
                    <Column><header><Text text="{i18n>columnTextShippedDate}" /></header></Column>
                    <Column><header><Text text="{i18n>columnTextShipName}" /></header></Column>
                    <Column><header><Text text="{i18n>columnTextShipCity}" /></header></Column>
                    <Column><header><Text text="{i18n>columnTextShipCountry}" /></header></Column>
                </columns>
                <items>
                    <ColumnListItem >
                        <ObjectIdentifier title="{OrderID}" />
                        <Text text="{   path:'OrderDate' }" />
                        <Text text="{   path:'RequiredDate',
                                        type:'sap.ui.model.type.Date',
                                        formatOptions:{
                                            pattern:'yyyy-MM-dd'
                                        }
                                    }" />
                        <Text text="{   path:'ShippedDate',
                                        type:'sap.ui.model.type.Date',
                                        formatOptions:{
                                            pattern:'yyyy-MM-dd'
                                        }
                                    }" />
                        <Text text="{ShipName}" />
                        <Text text="{ShipCity}" />
                        <Text text="{ShipCountry}" />
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <beginButton>
            <Button text="{i18n>buttonTextClose}" press=".onCloseDialog" />
        </beginButton>
    </Dialog>

</core:FragmentDefinition>