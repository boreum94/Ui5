<mvc:View controllerName="code.d22.exam4.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
>
    <Page id="page" title="{i18n>title}">
        <t:Table 
            rows="{path: '/Orders',
                    filters: {
                        path: 'OrderDate',
                        operator: 'BT',
                        value1: '1996-07-01',
                        value2: '1996-07-31'
                    }}"
            rowSelectionChange=".onRowSelectionChange"
            selectionBehavior="Row"
            selectionMode="Single"
        >
            <t:rowMode>
                <rowmodes:Auto/>
            </t:rowMode>
            <t:columns>
                <t:Column>
                    <t:label>
                        <Label text="{i18n>columnOrderID}"/>
                    </t:label>
                    <t:template>
                        <ObjectIdentifier title="{OrderID}"/>
                    </t:template>
                </t:Column>
                <t:Column>
                    <t:label>
                        <Label text="{i18n>columnCustomerID}"/>
                    </t:label>
                    <t:template>
                        <ObjectIdentifier title="{CustomerID}"/>
                    </t:template>
                </t:Column>
                <t:Column>
                    <t:label>
                        <Label text="{i18n>columnEmployeeID}"/>
                    </t:label>
                    <t:template>
                        <ObjectIdentifier title="{EmployeeID}"/>
                    </t:template>
                </t:Column>
                <t:Column>
                    <t:label>
                        <Label text="{i18n>columnOrderDate}"/>
                    </t:label>
                    <t:template>
                        <ObjectIdentifier title="{path: 'OrderDate',
                                                type: 'sap.ui.model.type.Date',
                                                formatOptions: {
                                                    pattern: 'yyyy.MM.dd'
                                                }}"/>
                    </t:template>
                </t:Column>
                <t:Column>
                    <t:label>
                        <Label text="{i18n>columnRequiredDate}"/>
                    </t:label>
                    <t:template>
                        <ObjectIdentifier title="{path: 'RequiredDate',
                                                type: 'sap.ui.model.type.Date',
                                                formatOptions: {
                                                    pattern:'yyyy.MM.dd'
                                                }}"/>
                    </t:template>
                </t:Column>
                <t:Column>
                    <t:label>
                        <Label text="{i18n>columnShipmentDate}"/>
                    </t:label>
                    <t:template>
                        <ObjectIdentifier title="{path: 'ShippedDate',
                                                type: 'sap.ui.model.type.Date',
                                                formatOptions: {
                                                    pattern: 'yyyy.MM.dd'
                                                }}"/>
                    </t:template>
                </t:Column>
            </t:columns>
        </t:Table>
    </Page>
</mvc:View>