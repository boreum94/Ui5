{
  "_version": "1.60.0",
  "sap.app": {
    "id": "code.d22.project1",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.24.0",
      "toolsId": "9ae26517-a0ea-46a7-bd98-d0cf18ef64f4"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_tfed22_o4/srvd/sap/zui_tfed22_o4/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.23",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "code.d22.project1.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ZC_TFED22List",
          "target": [
            "ZC_TFED22List"
          ]
        },
        {
          "pattern": "ZC_TFED22({key}):?query:",
          "name": "ZC_TFED22ObjectPage",
          "target": [
            "ZC_TFED22List",
            "ZC_TFED22ObjectPage"
          ]
        }
      ],
      "targets": {
        "ZC_TFED22List": {
          "type": "Component",
          "id": "ZC_TFED22List",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZC_TFED22",
              "variantManagement": "Page",
              "navigation": {
                "ZC_TFED22": {
                  "detail": {
                    "route": "ZC_TFED22ObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "columns": {
                    "RemainSeatsCol": {
                      "header": "RemainSeats",
                      "position": {
                        "anchor": "DataField::SeatsOccupied",
                        "placement": "After"
                      },
                      "template": "code.d22.project1.ext.fragment.RemainSeatsCol"
                    }
                  }
                },
                "@com.sap.vocabularies.UI.v1.SelectionFields": {
                  "filterFields": {
                    "idSeatsOccFilter": {
                      "label": "Seats Occ",
                      "property": "SeatsOccupied",
                      "template": "code.d22.project1.ext.fragment.SeatsOccFilter",
                      "required": false,
                      "position": {
                        "placement": "After",
                        "anchor": "ConnectionID"
                      }
                    },
                    "idFlightDate": {
                      "label": "Flight Date",
                      "property": "FlightDate",
                      "template": "code.d22.project1.ext.fragment.FlightDateFilter",
                      "required": false,
                      "position": {
                        "placement": "After",
                        "anchor": "ConnectionID"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "ZC_TFED22ObjectPage": {
          "type": "Component",
          "id": "ZC_TFED22ObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZC_TFED22"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "code.d22.project1.ext.controller.ListReportMap"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
